@{
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var emp = User.FindFirst("EmployeeId")?.Value;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Leave</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
@if (User.Identity?.IsAuthenticated == true)
{
    <nav class="navbar navbar-expand-md navbar-dark sticky-top" style="background:#0e7490">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🌴 Leave System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="nav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">My Page</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Leave" asp-action="Mine">My Leaves</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a></li>
                    @if (User.IsInRole("Manager") || User.IsInRole("HR"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Approvals">Approvals</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Calendar">Team Calendar</a></li>
                    }
                    @if (User.IsInRole("HR"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Hr" asp-action="Index">HR Dashboard</a></li>
                    }
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">@fullName <span class="badge bg-info-subtle text-dark ms-1">@role</span></a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @if (emp is not null) { <li><a class="dropdown-item" asp-controller="Employees" asp-action="Details" asp-route-id="@emp">My profile</a></li> }
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-3">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Sign out</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
}

<main class="container py-4">
    @if (TempData["Success"] is string s)
    {
        <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
