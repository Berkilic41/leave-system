@model IEnumerable<LeaveRequest>
@{
    ViewData["Title"] = "Approvals";
    var status = ViewBag.Status as string ?? "Pending";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Approvals</h1>
    <div class="btn-group">
        <a class="btn btn-sm @(status == "Pending"   ? "btn-primary" : "btn-outline-primary")"  asp-action="Approvals" asp-route-status="Pending">Pending</a>
        <a class="btn btn-sm @(status == "Approved"  ? "btn-primary" : "btn-outline-primary")"  asp-action="Approvals" asp-route-status="Approved">Approved</a>
        <a class="btn btn-sm @(status == "Rejected"  ? "btn-primary" : "btn-outline-primary")"  asp-action="Approvals" asp-route-status="Rejected">Rejected</a>
        <a class="btn btn-sm @(status == "Cancelled" ? "btn-primary" : "btn-outline-primary")"  asp-action="Approvals" asp-route-status="Cancelled">Cancelled</a>
    </div>
</div>

<div class="card-section p-0">
    <table class="table mb-0 align-middle">
        <thead class="table-light">
            <tr><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="8" class="text-center text-muted py-4">No requests in this status.</td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td><a asp-controller="Employees" asp-action="Details" asp-route-id="@r.EmployeeId" class="text-decoration-none"><strong>@r.EmployeeName</strong></a><div class="text-muted small">@r.DepartmentName</div></td>
                    <td>@r.LeaveTypeName</td>
                    <td>@r.StartDate.ToString("MMM d")</td>
                    <td>@r.EndDate.ToString("MMM d")</td>
                    <td>@r.Days</td>
                    <td class="text-muted small" style="max-width:240px">@r.Reason</td>
                    <td><span class="status-badge status-@r.Status">@r.Status</span></td>
                    <td>
                        @if (r.Status == "Pending")
                        {
                            <form asp-action="Decide" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.Id" />
                                <input type="hidden" name="status" value="Approved" />
                                <button class="btn btn-sm btn-success">✓</button>
                            </form>
                            <button class="btn btn-sm btn-outline-danger reject-btn" data-id="@r.Id">✕</button>
                        }
                        else
                        {
                            <a asp-controller="Leave" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Reject modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="Decide" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="status" value="Rejected" />
        <input type="hidden" name="id" id="reject-id" />
        <div class="modal-header"><h5 class="modal-title">Reject leave request</h5></div>
        <div class="modal-body">
          <label class="form-label">Reason for rejection</label>
          <textarea name="note" class="form-control" rows="3" required maxlength="500"></textarea>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-danger">Reject</button>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.reject-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('reject-id').value = btn.dataset.id;
                new bootstrap.Modal(document.getElementById('rejectModal')).show();
            });
        });
    </script>
}
