@model EmployeeFormViewModel
@{ ViewData["Title"] = "Edit employee"; }

<a asp-action="Details" asp-route-id="@Model.Id" class="text-muted small text-decoration-none">← Back to profile</a>

<div class="row justify-content-center mt-2">
    <div class="col-md-7">
        <div class="card-section">
            <h1 class="h4 mb-4">Edit employee</h1>
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DepartmentId" class="form-label">Department</label>
                        <select asp-for="DepartmentId" class="form-select">
                            @foreach (var d in Model.Departments) { <option value="@d.Id">@d.Name</option> }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="HireDate" class="form-label"></label>
                        <input asp-for="HireDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Position" class="form-label"></label>
                    <input asp-for="Position" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="ManagerId" class="form-label">Manager</label>
                    <select asp-for="ManagerId" class="form-select">
                        <option value="">— No manager —</option>
                        @foreach (var m in Model.AvailableManagers.Where(m => m.Id != Model.Id))
                        {
                            <option value="@m.Id">@m.FullName · @m.Position · @m.DepartmentName</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save changes</button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
