@model LeaveRequestFormViewModel
@{ ViewData["Title"] = "New leave request"; }

<a asp-action="Mine" class="text-muted small text-decoration-none">← Back to my leaves</a>

<div class="row mt-2">
    <div class="col-lg-7">
        <div class="card-section">
            <h1 class="h4 mb-3">Request leave</h1>
            <form asp-action="Create" method="post" id="leave-form">
                @Html.AntiForgeryToken()
                <div class="alert alert-danger" asp-validation-summary="ModelOnly"></div>

                <div class="mb-3">
                    <label asp-for="LeaveTypeId" class="form-label">Leave type</label>
                    <select asp-for="LeaveTypeId" class="form-select">
                        <option value="">Select...</option>
                        @foreach (var t in Model.LeaveTypes)
                        {
                            <option value="@t.Id" data-paid="@t.IsPaid.ToString().ToLower()">@t.Name (@(t.IsPaid ? "paid" : "unpaid"))</option>
                        }
                    </select>
                    <span asp-validation-for="LeaveTypeId" class="text-danger small"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartDate" class="form-label">From</label>
                        <input asp-for="StartDate" type="date" class="form-control" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="StartDate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="EndDate" class="form-label">To</label>
                        <input asp-for="EndDate" type="date" class="form-control" min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="EndDate" class="text-danger small"></span>
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Reason" class="form-label">Reason (optional)</label>
                    <textarea asp-for="Reason" rows="3" class="form-control" maxlength="1000"></textarea>
                </div>

                <div id="day-summary" class="alert alert-info mb-3 d-none"></div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Submit request</button>
                    <a asp-action="Mine" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card-section">
            <h2 class="h6 mb-3">Your balance — @DateTime.UtcNow.Year</h2>
            @foreach (var b in Model.Balance)
            {
                <div class="d-flex justify-content-between border-bottom py-2">
                    <span><strong>@b.LeaveTypeName</strong>@(b.IsPaid ? "" : " (unpaid)")</span>
                    <span><strong class="@(b.Remaining < 5 ? "text-danger" : "text-success")">@b.Remaining</strong> / @b.AnnualDays</span>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live day count calculation + simple client-side validation
        const start = document.querySelector('[name="StartDate"]');
        const end = document.querySelector('[name="EndDate"]');
        const summary = document.getElementById('day-summary');

        function update() {
            const s = new Date(start.value);
            const e = new Date(end.value);
            if (isNaN(s) || isNaN(e) || e < s) { summary.classList.add('d-none'); return; }
            const days = Math.round((e - s) / 86400000) + 1;
            summary.textContent = `Requesting ${days} day${days === 1 ? '' : 's'} of leave.`;
            summary.classList.remove('d-none');
        }
        start.addEventListener('change', update);
        end.addEventListener('change', update);
        document.getElementById('leave-form').addEventListener('submit', (e) => {
            const s = new Date(start.value);
            const en = new Date(end.value);
            if (en < s) { e.preventDefault(); alert('End date must be on or after start date.'); }
        });
    </script>
}
